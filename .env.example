# ── Capacities ─────────────────────────────────────────────────────────────────
# Generate at: https://app.capacities.io/settings/api
CAPACITIES_API_TOKEN=your_capacities_api_token_here
CAPACITIES_SPACE_ID=your_space_id_here

# ── Todoist ─────────────────────────────────────────────────────────────────────
# Generate at: https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=your_todoist_api_token_here

# ── Gmail / Google ──────────────────────────────────────────────────────────────
# Path to your OAuth2 credentials JSON downloaded from Google Cloud Console.
# See setup guide in README for how to create these.
GOOGLE_CREDENTIALS_FILE=config/google_credentials.json
# Token is auto-generated after first OAuth login; leave path as-is.
GOOGLE_TOKEN_FILE=config/google_token.json

# Gmail search query used to find "due today" emails.
# Default finds starred, unread emails. Adjust to match your workflow.
# Examples:
#   label:follow-up is:unread
#   label:action-required
#   is:starred is:unread newer_than:7d
GMAIL_DUE_TODAY_QUERY=is:starred is:unread

# ── Logging ─────────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log file path (leave blank to log to stdout only)
LOG_FILE=logs/morning_brief.log
